# Variáveis de ambiente do n8n local para os workflows de exemplo. Valores fictícios: troque pelos seus.
API_BANCO_URL=http://localhost:54321
API_BANCO_CHAVE=troque-pela-chave-publica-do-seu-banco
API_BANCO_JWT=troque-pelo-jwt-de-servico-do-seu-banco
TOKEN_ENTRADA=troque-por-um-token-aleatorio
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=troque-pela-chave-do-seu-provedor-de-whatsapp
# Usadas pelo coletor de custo e pelo registro de uso (API do próprio n8n):
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=troque-pela-chave-da-api-do-seu-n8n
